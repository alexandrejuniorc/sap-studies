<mvc:View
    controllerName="studies.freestyleappnotion.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <List
                headerText="{i18n>productsTitle}"
                headerLevel="H2"
                items="{productsModel>/produtos}"
                itemPress="onItemPress"
            >
                <StandardListItem
                    type="Active"
                    title="{productsModel>nome}"
                    counter="{productsModel>quantidade}"
                />
            </List>
        </content>
    </Page>
</mvc:View>
