<mvc:View
    controllerName="studies.freestyleappnotion.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
        busy="{viewModel>/isLoading}"
        busyIndicatorSize="Medium"
        busyIndicatorDelay="0"
        showHeader="false"
    >
        <content>
            <OverflowToolbar>
                <ToolbarSpacer />
                <SearchField
                    liveChange=".onFiltrarProdutos"
                    width="22rem"
                />
            </OverflowToolbar>

            <List
                id="listaProdutos"
                itemPress="onItemPress"
                headerText="{i18n>productsTitle}"
                items="{
                    path: 'productsModel>/produtos',
                    sorter: [
                        {
                            path: 'categoria', 
                            descending: false, 
                            group: true
                        },
                        {
                            path: 'nome', 
                            descending: false
                        }
                    ],
                    groupHeaderFactory: '.criarCabecalhoGrupo'
                }"
            >
                <ObjectListItem
                    title="{productsModel>nome}"
                    type="Active"
                    press="onItemPress"
                    number="{path: 'productsModel>preco', formatter: '.formatter.formatarPreco'}"
                    numberUnit="Preço"
                    visible="{path: 'productsModel>quantidade', formatter: '.formatter.visivelSeTemEstoque'}"
                >
                    <firstStatus>
                        <ObjectStatus
                            text="{path: 'productsModel>status', formatter: '.formatter.traduzirStatus'}"
                            state="{path: 'productsModel>status', formatter: '.formatter.corStatus' }"
                        />
                    </firstStatus>

                    <attributes>
                        <ObjectAttribute text="{productsModel>categoria}" />
                        <ObjectAttribute
                            text="Qtd: {productsModel>quantidade}"
                        />
                    </attributes>
                </ObjectListItem>

                <!-- <StandardListItem
                    type="Active"
                    title="{productsModel>nome}"
                    info="{productsModel>quantidade}"
                    description="{productsModel>categoria}"
                /> -->
            </List>
        </content>
    </Page>
</mvc:View>
