<mvc:View controllerName="moovi.sapfioridatanavigationsample.controller.CompanyDetail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form" busyIndicatorDelay="0">
    <Page id="companyDetailPage" title="{i18n>companyDetailsOf} {Carrname}" showNavButton="true" navButtonPress="onNavBack" class="sapUiResponsiveContentPadding">
        <content>
            <Panel id="companyDetailPanel" width="auto" class="sapUiResponsiveMargin sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar id="_IDGenToolbar">
                        <Title id="_IDGenTitle" text="{i18n>companyID} {Carrid}" level="H2" />
                        <ToolbarSpacer id="_IDGenToolbarSpacer" />
                    </Toolbar>
                </headerToolbar>

                <content>
                    <f:SimpleForm id="formEdit" editable="false" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1">
                        <f:content>
                            <Label id="_IDGenLabel1" text="{i18n>companyID}" />
                            <Input id="_IDGenInput2" type="Text" value="{Carrid}" />

                            <Label id="_IDGenLabel" text="{i18n>CompanyName}" />
                            <Input id="_IDGenInput" type="Text" value="{Carrname}" />

                            <Label id="_IDGenLabel2" text="{i18n>CurrCode}" />
                            <Input id="_IDGenInput3" type="Text" value="{Currcode}" />

                            <Label id="_IDGenLabel3" text="{i18n>Url}" />
                            <Input id="_IDGenInput4" type="Text" value="{Url}" />
                        </f:content>
                    </f:SimpleForm>
                </content>
            </Panel>
        </content>

        <footer>
            <OverflowToolbar id="_IDGenOverflowToolbar">
                <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                <Button id="_IDGenButtonEdit" text="Salvar" type="Accept" press=".onBtnSavePress" />
                <Button id="_IDGenButtonDelete" text="Excluir" type="Reject" press=".onBtnDeletePress" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
